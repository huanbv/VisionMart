# ============================================================
# VisionMart - Environment configuration (example)
# Copy to ".env" and adjust values for your environment.
# Never commit a real ".env" file.
# ============================================================

# ---------- Global ----------
APP_NAME=VisionMart
APP_ENV=development               # development | staging | production
APP_DEBUG=true
APP_TIMEZONE=UTC
LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT=json                   # json | text
# Docker's per-container log rotation (docker-compose.yml's shared
# "default-logging" anchor, driver "local" — auto-compressed rotated
# files, applies to backend/ai-engine/celery/frontend/nginx/monitoring
# uniformly). See docs/18_LOGGING.md for the full log-management design
# and the recommended-defaults rationale.
LOG_MAX_FILE_SIZE=100m
LOG_MAX_FILES=5

# ---------- Release information (release_info.json; see docs/44_VERSIONING.md) ----------
# Populated at build/deploy time by scripts/generate_release_info.py and
# read by the monitoring service's /api/release-info endpoint. Safe to
# leave unset in development — everything falls back to "unknown".
# NOTE: the canonical project version now lives in the `VERSION` file at
# the repo root (currently "1.0.0-rc1") — that file takes priority over
# RELEASE_VERSION below. RELEASE_VERSION is only used as a fallback if the
# VERSION file is ever absent, or to stamp a one-off build number in CI.
RELEASE_VERSION=1.0.0-rc1
RELEASE_ENVIRONMENT_LABEL=development

# ---------- Backend ----------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_WORKERS=2
BACKEND_CORS_ORIGINS=http://localhost:3000,https://visionmart.thehuan.com
BACKEND_SECRET_KEY=change-me-please-generate-a-strong-secret
BACKEND_API_PREFIX=/api/v1

# ---------- Auth (JWT RS256) ----------
# backend/app/config/settings.py defaults JWT_PRIVATE_KEY_PATH/
# JWT_PUBLIC_KEY_PATH to /run/secrets/jwt_{private,public}.pem, which is
# exactly where docker-compose.yml mounts ./secrets (read-only) into the
# backend/celery-worker/celery-beat containers. Generate the keypair
# with: scripts/generate-secrets.sh (Part 3/14 of the DevOps toolkit) --
# no override needed here unless you place the keys somewhere else.

# ---------- Initial admin seed (backend/app/scripts/seed_initial.py -- idempotent) ----------
SEED_ADMIN_EMAIL=admin@visionmart.local
SEED_ADMIN_USERNAME=admin
# Left empty here on purpose: scripts/generate-secrets.sh fills this in
# with a generated value the first time it runs against a fresh .env.
# If you seed manually instead, the code default is the fixed
# placeholder "ChangeMe!2026" (see settings.py) -- change it before
# going live either way.
SEED_ADMIN_PASSWORD=
SEED_ORGANIZATION_NAME=VisionMart Demo
SEED_ORGANIZATION_SLUG=demo

# ---------- AI Engine ----------
AI_ENGINE_HOST=0.0.0.0
AI_ENGINE_PORT=8100
AI_ENGINE_BASE_URL=http://ai-engine:8100

# ---------- YOLO ----------
YOLO_MODEL=yolov8n.pt
# Canonical detection weight (YoloDetector + cart tracker). Empty = YOLO_MODEL.
# After "Triển khai" a trained job this is persisted in ai-engine/config/vision_runtime.json.
YOLO_MODEL_PATH=
YOLO_CONF_THRESHOLD=0.25
YOLO_DEVICE=cpu
MODELS_DIR=/models

# ---------- OpenCV Vision Pipeline (ai-engine/app/vision/) ----------
# OpenCV Integration Sprint 1: optional preprocessing/analysis inserted
# between frame capture and YOLO. Every flag below defaults to false/off —
# leaving all of them unset (or false) makes the pipeline behave exactly
# as it did before this Sprint (plain decode, no ROI/enhancement/quality).
# See docs/22_VIDEO_PIPELINE.md and docs/OPENCV_INTEGRATION_SPRINT1_REPORT.md.
ENABLE_ROI=false
ROI_CONFIG_PATH=                       # e.g. /app/config/roi_zones.yaml — see ai-engine/config/roi_zones.example.yaml
ENABLE_CLAHE=false
CLAHE_CLIP_LIMIT=2.0
CLAHE_TILE_GRID_SIZE=8
ENABLE_HIST_EQ=false
ENABLE_BRIGHTNESS_ADJUST=false
BRIGHTNESS_DELTA=0
ENABLE_CONTRAST_ADJUST=false
CONTRAST_ALPHA=1.0
ENABLE_GAMMA=false
GAMMA_VALUE=1.0
ENABLE_GAUSSIAN_BLUR=false
GAUSSIAN_KERNEL_SIZE=5
ENABLE_MEDIAN_BLUR=false
MEDIAN_KERNEL_SIZE=5

# --- Sprint 2 additions (Gonzalez & Woods Ch.3/Ch.5 techniques) ---
# Bilateral: edge-preserving denoise. Keeps object edges sharp (unlike
# Gaussian/median), at the highest CPU cost of the smoothers — measure with
# `evaluation` before enabling on a busy camera.
ENABLE_BILATERAL=false
BILATERAL_DIAMETER=9
BILATERAL_SIGMA_COLOR=75.0
BILATERAL_SIGMA_SPACE=75.0
# Unsharp masking / highboost. UNSHARP_AMOUNT=1.0 is textbook unsharp
# masking, >1 is highboost (halo risk). UNSHARP_THRESHOLD>0 avoids
# amplifying sensor noise in dark frames.
ENABLE_UNSHARP_MASK=false
UNSHARP_AMOUNT=0.6
UNSHARP_RADIUS=3
UNSHARP_THRESHOLD=5
# Auto gamma: derives the exponent per frame from measured brightness, so
# one config works across day/night. Takes precedence over ENABLE_GAMMA.
# NOTE: in this codebase apply_gamma uses exponent 1/gamma, so values > 1
# BRIGHTEN and values < 1 DARKEN.
ENABLE_AUTO_GAMMA=false
AUTO_GAMMA_TARGET_BRIGHTNESS=120.0
AUTO_GAMMA_MIN=0.5
AUTO_GAMMA_MAX=3.0
# Adaptive median (Ch.5): removes salt-and-pepper at higher densities than
# a fixed-window median while preserving detail it would otherwise erase.
ENABLE_ADAPTIVE_MEDIAN=false
ADAPTIVE_MEDIAN_MAX_KERNEL=7

ENABLE_IMAGE_QUALITY=false
ENABLE_BLUR_ANALYSIS=false
BLUR_THRESHOLD=100.0
IMAGE_QUALITY_THRESHOLD=0.5
ENABLE_PERFORMANCE_METRICS=false
ENABLE_DEBUG_OVERLAY=false

# Per-stage pipeline trace — powers the admin "see every step" screen.
# Stores one JPEG per preprocessing stage, so keep it off on busy cameras.
ENABLE_PIPELINE_TRACE=false
TRACE_SAMPLE_RATE=0.0                  # 0 = only when explicitly requested
# Settings above can also be changed at runtime from the admin UI
# (Cấu hình xử lý ảnh); those overrides live in this file and win over env:
VISION_RUNTIME_CONFIG_PATH=/app/config/vision_runtime.json

# ---------- Active learning (review queue) ----------
# Forwards a rate-limited sample of *uncertain* detections to the review
# queue, where a human confirms the label before it becomes training data.
# Never blocks detection: uploads are fire-and-forget and failures are logged.
ENABLE_REVIEW_CAPTURE=false
REVIEW_CAPTURE_MIN_CONFIDENCE=0.15     # ignore near-zero scores (usually noise)
REVIEW_CAPTURE_COOLDOWN_SECONDS=60     # max one capture per camera per window

# ---------- Detection Alerts ----------
DETECTION_ALERT_MIN_CONFIDENCE=0.7
DETECTION_ALERT_CLASSES=person
DETECTION_ALERT_DEDUP_SECONDS=60
DETECTION_ALERT_FALLBACK_ROLE_CODE=org_admin

# ---------- Auth rate limiting ----------
AUTH_LOGIN_RATE_LIMIT=10
AUTH_LOGIN_RATE_WINDOW_SECONDS=300
AUTH_REFRESH_RATE_LIMIT=60
AUTH_REFRESH_RATE_WINDOW_SECONDS=300

# ---------- RTSP Auto Capture ----------
# Generic detection + alerts feed only (calls /capture). Does NOT run
# tracking or cart automation — see FRAME_PIPELINE_* below for that.
RTSP_CAPTURE_ENABLED=false
RTSP_CAPTURE_INTERVAL_SECONDS=60
RTSP_CAPTURE_MAX_CAMERAS=20
RTSP_CAPTURE_OPEN_TIMEOUT_MS=5000

# ---------- Continuous Frame Pipeline (product pickup/return + checkout AI) ----------
# Calls /ai/frame at a much higher frequency than RTSP_CAPTURE_* — this is
# what actually drives product_picked_up / product_returned / checkout_initiated
# from real cameras. Off by default: each camera holds its own full YOLO
# model in ai-engine RAM (see ai-engine/app/services/person_tracker.py), so
# raise FRAME_PIPELINE_MAX_CAMERAS gradually and watch memory, especially on
# small VPS instances. This is the initial state only; the Live Cart
# "AI tự động" switch persists an explicit per-branch override in Redis.
FRAME_PIPELINE_ENABLED=false
FRAME_PIPELINE_INTERVAL_SECONDS=3
FRAME_PIPELINE_MAX_CAMERAS=8
FRAME_PIPELINE_MIN_CONFIDENCE=0.4
FRAME_PIPELINE_RECOGNIZE_FACE=false
FRAME_PIPELINE_OPEN_TIMEOUT_MS=4000
# Checkout-zone cameras emit product_scanned events without grab-and-go
# hand pairing. Keep true for Live Cart automatic basket creation.
CHECKOUT_SCAN_MODE=true

# ---------- Camera simulation (course project — no physical cameras yet) ----------
# Only used by the optional `rtsp-sim` / `camera-sim-runner` services in
# docker-compose.yml (`docker compose --profile camera-sim up`). Upload a
# demo video per camera from the Cameras page ("Tai video demo len" button)
# -- the backend (app/modules/camera/application/camera_sim.py) stores it
# in a separate public-read MinIO bucket and camera-sim-runner loops it as
# that camera's RTSP stream. Camera.stream_url is then auto-set to
# rtsp://<CAMERA_SIM_RTSP_HOST>:<CAMERA_SIM_RTSP_PORT>/cam-{camera_id} --
# exactly like a real IP camera. Safe to delete once real cameras exist.
RTSP_SIM_PORT=8554
MINIO_CAMERA_SIM_BUCKET=camera-sim
CAMERA_SIM_RTSP_HOST=rtsp-sim
CAMERA_SIM_RTSP_PORT=8554

# ---------- Cross-camera visitor linking (anonymous journey heuristic) ----------
# No ML re-identification model — nearest-active-visitor-in-time heuristic.
# See backend/app/modules/sales/application/visitor_linker.py for limitations.
VISITOR_HANDOFF_WINDOW_SECONDS=20
VISITOR_TRACK_TTL_SECONDS=90
VISITOR_ACTIVE_TTL_SECONDS=600

# ---------- Detection Retention ----------
DETECTION_CLEANUP_ENABLED=true
DETECTION_RETENTION_DAYS=30
DETECTION_CLEANUP_INTERVAL_SECONDS=3600
DETECTION_CLEANUP_BATCH_SIZE=500

# ---------- Shopping Cart / AI Checkout ----------
AI_ENGINE_API_KEY=change-me-ai-engine-key
CART_EXPIRATION_MINUTES=30
CART_SWEEPER_INTERVAL_SECONDS=60
CART_AI_MIN_CONFIDENCE=0.6
# AI engine calls back to backend on this URL
BACKEND_BASE_URL=http://backend:8000/api/v1

# ---------- AI-assisted checkout confirmation ----------
# AI detection stops at "pending checkout" — it never charges a customer.
# Confirmation (by the customer via QR, or by staff) and payment are a
# separate, human-in-the-loop step below.
# checkout_initiated no longer charges instantly — the cart freezes into
# PENDING_CHECKOUT and waits for this many minutes for the customer (QR
# scan) or staff ("Xác nhận hộ") to confirm before reverting to ACTIVE.
CART_CHECKOUT_CONFIRM_TIMEOUT_MINUTES=5
# Public origin used to build the QR/confirm link shown to customers —
# must be reachable from a customer's own phone, not an internal Docker
# hostname.
PUBLIC_APP_BASE_URL=https://visionmart.thehuan.com

# ---------- Payment gateway ----------
PAYMENT_GATEWAY=simulated             # simulated | vnpay | momo (future)
PAYMENT_SIMULATE_SUCCESS_RATE=1.0

# ---------- AI Engine tracker / recognizer ----------
# JSON file that maps a YOLO class_name to a product SKU per branch/org.
# Format: {"organization_id": {"branch_id": {"class_name": "SKU"}}}
CLASS_TO_SKU_PATH=/app/config/class_to_sku.json
TRACK_PICK_COOLDOWN_SECONDS=5
# How long a picked-up product can go undetected near the same (still
# in-frame) person before it's treated as put back on the shelf. Too low
# and brief occlusion triggers false product_returned events; too high and
# real returns take longer to register.
PRODUCT_RETURN_MISSING_SECONDS=3
FACE_RECOGNIZER_ENABLED=false

# ---------- Frontend ----------
FRONTEND_PORT=3000
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_BASE_URL=ws://localhost:8000/ws
# Trang Phân tích Video (VideoAnalysisPage.tsx) gọi thẳng ai-engine từ
# trình duyệt (không qua backend) nên cần biết X-AI-Engine-Key ở phía
# client. PHẢI đặt giống hệt AI_ENGINE_API_KEY ở trên — nếu lệch, trang đó
# nhận lỗi 401 "Invalid or missing X-AI-Engine-Key". Key này vẫn nằm trong
# JS bundle gửi tới trình duyệt (không có cách nào khác khi gọi thẳng từ
# client) nhưng ít nhất không bị commit cứng vào lịch sử git.
VITE_AI_ENGINE_KEY=change-me-ai-engine-key

# ---------- PostgreSQL ----------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=visionmart
POSTGRES_USER=visionmart
POSTGRES_PASSWORD=visionmart
DATABASE_URL=postgresql+asyncpg://visionmart:visionmart@postgres:5432/visionmart

# ---------- Redis ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0

# ---------- Celery ----------
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ---------- MinIO (S3 compatible) ----------
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=visionmart
MINIO_ROOT_PASSWORD=visionmart-minio
MINIO_BUCKET=visionmart
MINIO_USE_SSL=false
MINIO_CONSOLE_PORT=9001
# Public host/scheme used to rewrite presigned URLs so the BROWSER (not the
# backend container) can load them. Without this, presigned URLs keep the
# internal Docker hostname (e.g. "minio:9000") and image previews break in
# production. nginx exposes MinIO under the "/visionmart/" path (see
# docker/nginx/conf.d/default.conf), so point these at the public domain:
MINIO_PUBLIC_ENDPOINT=visionmart.thehuan.com
MINIO_PUBLIC_USE_SSL=true
MINIO_PUBLIC_PATH_PREFIX=/visionmart

# ---------- Nginx ----------
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# ---------- Backup (backup/, read-only against production) ----------
# Standalone service (docker-compose services "backup"/"backup-once") that
# dumps Postgres (pg_dump, non-blocking), copies the monitoring SQLite file
# (SQLite online backup API), copies evaluation reports, downloads MinIO
# uploads, and copies an explicit list of config files into a checksummed,
# verified zip. See docs/43_BACKUP_RECOVERY.md for the full strategy and
# restore procedure.
BACKUP_DIR=/var/backups/visionmart
BACKUP_RETENTION_DAYS=14
# Cron expression for the optional in-stack scheduler (docker-compose
# service "backup"). Host-cron users calling `docker compose run --rm
# backup-once` instead can ignore this.
BACKUP_CRON_SCHEDULE="0 2 * * *"
BACKUP_EVALUATION_REPORTS_DIR=/app/repo/evaluation_results
BACKUP_REPO_ROOT=/app/repo
BACKUP_CONFIG_FILES=docker-compose.yml,docker-compose.prod.yml,.env.example,alembic.ini,backend/alembic.ini,docker/nginx/nginx.conf,docker/nginx/conf.d,docs
# .env holds production secrets — excluded from backups unless explicitly enabled.
BACKUP_INCLUDE_ENV_FILE=false
BACKUP_INCLUDE_UPLOADS=true
BACKUP_LOG_DIR=/data/logs
BACKUP_LOG_MAX_BYTES=10485760
BACKUP_LOG_BACKUP_COUNT=5

# ---------- Operational Monitoring (monitoring/, read-only) ----------
# Standalone service (docker-compose service "monitoring") that observes the
# rest of the stack over HTTP/SQL/Redis/Celery/Docker — it never imports
# backend/ai-engine code and never writes to production data. See
# docs/19_MONITORING.md for the full design and deployment guide.
# MONITORING_API_TOKEN must be identical here and wherever the monitoring
# service itself reads it (this file) — the backend's ops_monitoring proxy
# uses it server-side, the browser never sees it directly.
MONITORING_API_TOKEN=change-me-monitoring-token
MONITORING_SERVICE_URL=http://monitoring:8200
MONITORING_BACKEND_URL=http://backend:8000
MONITORING_AI_ENGINE_URL=http://ai-engine:8100
MONITORING_POLL_INTERVAL_SECONDS=30
MONITORING_SQLITE_PATH=/data/monitoring.db
MONITORING_RETENTION_DAYS=30
MONITORING_LOG_DIR=/data/logs
MONITORING_LOG_MAX_BYTES=10485760
MONITORING_LOG_BACKUP_COUNT=5
MONITORING_ALERT_CPU_PERCENT=90
MONITORING_ALERT_RAM_PERCENT=90
MONITORING_ALERT_DISK_PERCENT=85
MONITORING_ALERT_PIPELINE_LATENCY_MS=1000
MONITORING_ALERT_CAMERA_OFFLINE_GRACE_SECONDS=120
MONITORING_ALERT_MIN_FPS=1.0
# Optional Slack/Discord-compatible webhook for alert notifications.
MONITORING_WEBHOOK_URL=
# Optional: mount /var/run/docker.sock to enable container-level checks
# (see docker-compose.yml's commented-out volume on the "monitoring" service).
MONITORING_DOCKER_SOCKET=unix://var/run/docker.sock
MONITORING_DOCKER_PREFIX=visionmart-
# Read-only repo mount (docker-compose.yml's "monitoring" service mounts
# ".:/app/repo:ro") — powers the optional Evaluation signal in the Health
# Score / Readiness Report, and the Release Information endpoint's read
# of release_info.json (see scripts/generate_release_info.py).
MONITORING_REPO_ROOT=/app/repo
MONITORING_EVALUATION_REPORTS_DIR=/app/repo/evaluation_results

# =====================================================================
# v3 — Nâng cấp pipeline AI (xem docs/AI_PIPELINE_UPGRADE.md)
# =====================================================================
# QUAN TRỌNG: mọi cờ dưới đây MẶC ĐỊNH TẮT. Tắt hết = hành vi y hệt v2.
# Cả 72 cài đặt này sửa được trực tiếp trong Admin (Cấu hình xử lý ảnh)
# mà không cần restart — chỉnh ở đây chỉ để đặt giá trị khởi tạo.

# --- Tầng 2: phân loại SKU (MobileNetV3) ---
# Cần model đã train. Bật khi chưa có model => tự động rơi về class_map.
ENABLE_SKU_CLASSIFIER=false
CLASSIFIER_BACKEND=onnx
CLASSIFIER_MODEL_PATH=/models/sku_classifier.onnx
CLASSIFIER_LABELS_PATH=/models/sku_labels.json
CLASSIFIER_INPUT_SIZE=224
CLASSIFIER_MIN_CONFIDENCE=0.55
CROP_PADDING=0.08
CROP_MIN_SIZE=24

# --- OCR fallback: đọc nhãn khi tầng 2 lưỡng lự ---
# CẢNH BÁO: engine nặng 300MB–1GB, KHÔNG cài sẵn trong image.
# easyocr:   pip install easyocr      (~100MB, dễ cài)
# paddleocr: pip install paddleocr    (~1GB, chính xác hơn với chữ nhỏ)
ENABLE_OCR_FALLBACK=false
OCR_BACKEND=easyocr
OCR_LANGUAGES=en,vi
OCR_USE_GPU=false
# Chạy OCR khi classifier dưới ngưỡng này...
OCR_TRIGGER_CONFIDENCE=0.75
# ...hoặc khi hạng nhất/nhì quá sát (trường hợp hàng nhái, khác dung tích)
OCR_TRIGGER_MARGIN=0.15
OCR_MIN_TEXT_CONFIDENCE=0.4
OCR_MIN_HEIGHT=160
OCR_APPLY_CLAHE=true
# Trần mỗi khung — OCR là stage duy nhất có thể phá vỡ ngân sách thời gian
OCR_MAX_PER_FRAME=3
# Catalog thương hiệu+dung tích -> SKU (OCR cần để tra cứu)
PRODUCT_CATALOG_PATH=/app/config/product_catalog.json

# --- Embedding: khớp sản phẩm CHƯA từng train ---
# LƯU Ý: hai ngưỡng dưới là giá trị khởi điểm, PHẢI hiệu chỉnh trên
# embedding thật trước khi tin (xem mục 7.3 của báo cáo).
ENABLE_EMBEDDINGS=false
EMBEDDING_MIN_SIMILARITY=0.75
EMBEDDING_MIN_MARGIN=0.05

# --- DEBUG_AI: lưu 8 ảnh từng bước + pipeline.json ---
# Ghi qua hàng đợi nền, không làm chậm AI. Khi đầy thì BỎ mẫu.
DEBUG_AI=false
DEBUG_AI_QUEUE_SIZE=64
DEBUG_AI_WORKERS=2
DEBUG_AI_JPEG_QUALITY=85
# 1.0 = ghi mọi khung (chỉ hợp lý khi test). Camera thật nên 0.02–0.05.
DEBUG_AI_SAMPLE_RATE=1.0

# --- Telemetry: đẩy dữ liệu cho Bảng điều khiển AI ---
# Bật cái này thì dashboard mới có dữ liệu để hiển thị.
ENABLE_TELEMETRY=false
TELEMETRY_BATCH_SIZE=20
TELEMETRY_FLUSH_SECONDS=5.0
TELEMETRY_MAX_QUEUE=500

# --- Tối ưu bộ nhớ ---
# true = 1 model YOLO dùng chung mọi camera (8 camera: giảm ~88% RAM model).
# Không đổi kết quả nhận diện; trạng thái tracker vẫn tách riêng từng camera.
# Đặt false nếu chạy nhiều GPU và lock trở thành nút cổ chai.
SHARE_YOLO_WEIGHTS=true
