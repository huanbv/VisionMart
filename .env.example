# ============================================================
# VisionMart - Environment configuration (example)
# Copy to ".env" and adjust values for your environment.
# Never commit a real ".env" file.
# ============================================================

# ---------- Global ----------
APP_NAME=VisionMart
APP_ENV=development               # development | staging | production
APP_DEBUG=true
APP_TIMEZONE=UTC
LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT=json                   # json | text

# ---------- Backend ----------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_WORKERS=2
BACKEND_CORS_ORIGINS=http://localhost:3000,https://visionmart.thehuan.com
BACKEND_SECRET_KEY=change-me-please-generate-a-strong-secret
BACKEND_API_PREFIX=/api/v1

# ---------- AI Engine ----------
AI_ENGINE_HOST=0.0.0.0
AI_ENGINE_PORT=8100
AI_ENGINE_BASE_URL=http://ai-engine:8100

# ---------- YOLO ----------
YOLO_MODEL=yolov8n.pt
YOLO_CONF_THRESHOLD=0.25
YOLO_DEVICE=cpu

# ---------- Detection Alerts ----------
DETECTION_ALERT_MIN_CONFIDENCE=0.7
DETECTION_ALERT_CLASSES=person
DETECTION_ALERT_DEDUP_SECONDS=60
DETECTION_ALERT_FALLBACK_ROLE_CODE=org_admin

# ---------- Auth rate limiting ----------
AUTH_LOGIN_RATE_LIMIT=10
AUTH_LOGIN_RATE_WINDOW_SECONDS=300
AUTH_REFRESH_RATE_LIMIT=60
AUTH_REFRESH_RATE_WINDOW_SECONDS=300

# ---------- RTSP Auto Capture ----------
# Generic detection + alerts feed only (calls /capture). Does NOT run
# tracking or cart automation — see FRAME_PIPELINE_* below for that.
RTSP_CAPTURE_ENABLED=false
RTSP_CAPTURE_INTERVAL_SECONDS=60
RTSP_CAPTURE_MAX_CAMERAS=20
RTSP_CAPTURE_OPEN_TIMEOUT_MS=5000

# ---------- Continuous Frame Pipeline (product pickup/return + checkout AI) ----------
# Calls /ai/frame at a much higher frequency than RTSP_CAPTURE_* — this is
# what actually drives product_picked_up / product_returned / checkout_initiated
# from real cameras. Off by default: each camera holds its own full YOLO
# model in ai-engine RAM (see ai-engine/app/services/person_tracker.py), so
# raise FRAME_PIPELINE_MAX_CAMERAS gradually and watch memory, especially on
# small VPS instances.
FRAME_PIPELINE_ENABLED=false
FRAME_PIPELINE_INTERVAL_SECONDS=3
FRAME_PIPELINE_MAX_CAMERAS=8
FRAME_PIPELINE_MIN_CONFIDENCE=0.4
FRAME_PIPELINE_RECOGNIZE_FACE=false
FRAME_PIPELINE_OPEN_TIMEOUT_MS=4000

# ---------- Cross-camera visitor linking (anonymous journey heuristic) ----------
# No ML re-identification model — nearest-active-visitor-in-time heuristic.
# See backend/app/modules/sales/application/visitor_linker.py for limitations.
VISITOR_HANDOFF_WINDOW_SECONDS=20
VISITOR_TRACK_TTL_SECONDS=90
VISITOR_ACTIVE_TTL_SECONDS=600

# ---------- Detection Retention ----------
DETECTION_CLEANUP_ENABLED=true
DETECTION_RETENTION_DAYS=30
DETECTION_CLEANUP_INTERVAL_SECONDS=3600
DETECTION_CLEANUP_BATCH_SIZE=500

# ---------- Shopping Cart / AI Checkout ----------
AI_ENGINE_API_KEY=change-me-ai-engine-key
CART_EXPIRATION_MINUTES=30
CART_SWEEPER_INTERVAL_SECONDS=60
CART_AI_MIN_CONFIDENCE=0.6
# AI engine calls back to backend on this URL
BACKEND_BASE_URL=http://backend:8000/api/v1

# ---------- AI-assisted checkout confirmation ----------
# AI detection stops at "pending checkout" — it never charges a customer.
# Confirmation (by the customer via QR, or by staff) and payment are a
# separate, human-in-the-loop step below.
# checkout_initiated no longer charges instantly — the cart freezes into
# PENDING_CHECKOUT and waits for this many minutes for the customer (QR
# scan) or staff ("Xác nhận hộ") to confirm before reverting to ACTIVE.
CART_CHECKOUT_CONFIRM_TIMEOUT_MINUTES=5
# Public origin used to build the QR/confirm link shown to customers —
# must be reachable from a customer's own phone, not an internal Docker
# hostname.
PUBLIC_APP_BASE_URL=https://visionmart.thehuan.com

# ---------- Payment gateway ----------
PAYMENT_GATEWAY=simulated             # simulated | vnpay | momo (future)
PAYMENT_SIMULATE_SUCCESS_RATE=1.0

# ---------- AI Engine tracker / recognizer ----------
# JSON file that maps a YOLO class_name to a product SKU per branch/org.
# Format: {"organization_id": {"branch_id": {"class_name": "SKU"}}}
CLASS_TO_SKU_PATH=/app/config/class_to_sku.json
TRACK_PICK_COOLDOWN_SECONDS=5
# How long a picked-up product can go undetected near the same (still
# in-frame) person before it's treated as put back on the shelf. Too low
# and brief occlusion triggers false product_returned events; too high and
# real returns take longer to register.
PRODUCT_RETURN_MISSING_SECONDS=3
FACE_RECOGNIZER_ENABLED=false

# ---------- Frontend ----------
FRONTEND_PORT=3000
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_BASE_URL=ws://localhost:8000/ws

# ---------- PostgreSQL ----------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=visionmart
POSTGRES_USER=visionmart
POSTGRES_PASSWORD=visionmart
DATABASE_URL=postgresql+asyncpg://visionmart:visionmart@postgres:5432/visionmart

# ---------- Redis ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0

# ---------- Celery ----------
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ---------- MinIO (S3 compatible) ----------
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=visionmart
MINIO_ROOT_PASSWORD=visionmart-minio
MINIO_BUCKET=visionmart
MINIO_USE_SSL=false
MINIO_CONSOLE_PORT=9001
# Public host/scheme used to rewrite presigned URLs so the BROWSER (not the
# backend container) can load them. Without this, presigned URLs keep the
# internal Docker hostname (e.g. "minio:9000") and image previews break in
# production. nginx exposes MinIO under the "/visionmart/" path (see
# docker/nginx/conf.d/default.conf), so point these at the public domain:
MINIO_PUBLIC_ENDPOINT=visionmart.thehuan.com
MINIO_PUBLIC_USE_SSL=true
MINIO_PUBLIC_PATH_PREFIX=/visionmart

# ---------- Nginx ----------
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# ---------- Backup ----------
BACKUP_DIR=/var/backups/visionmart
BACKUP_RETENTION_DAYS=14
